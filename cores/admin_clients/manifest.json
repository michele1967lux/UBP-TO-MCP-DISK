{
    "name": "admin_clients",
    "version": "2.0.0",
    "description": "Enterprise Client Management module with KB authorization, model assignment, user limits, and full configuration management",
    "author": "UBP Team",
    "module_type": "admin",
    "architecture": "3-file-pattern",
    "requires_redis": true,
    "requires_postgres": false,
    "requires_event_bus": true,
    "operations": [
        {
            "name": "initialize",
            "description": "Initialize client management module with Redis and secret generation",
            "parameters": {},
            "returns": {
                "status": "string (initialized status)",
                "module": "string (module name)",
                "storage": "string (storage backend)",
                "security": "object (security features)",
                "features": "object (module features)"
            },
            "mcp_hints": {
                "read_only": true,
                "idempotent": true,
                "estimated_latency_ms": 100,
                "requires_session": false,
                "category": "admin"
            },
            "security": "none",
            "scope": "system",
            "client_types": []
        },
        {
            "name": "create_client",
            "description": "Create a new OAuth/API client with full enterprise configuration",
            "parameters": {
                "client_name": {
                    "type": "string",
                    "required": true,
                    "ui_type": "text",
                    "label": "Client Name",
                    "description": "Identificativo univoco del client",
                    "validation": {
                        "minLength": 3,
                        "maxLength": 100
                    }
                },
                "client_type": {
                    "type": "string",
                    "required": true,
                    "ui_type": "select",
                    "label": "Client Type",
                    "description": "Tipo di autenticazione",
                    "options": [
                        {
                            "label": "OAuth2",
                            "value": "oauth2"
                        },
                        {
                            "label": "API Key",
                            "value": "api_key"
                        },
                        {
                            "label": "Service Account",
                            "value": "service_account"
                        }
                    ]
                },
                "description": {
                    "type": "string",
                    "required": false,
                    "ui_type": "textarea",
                    "label": "Description",
                    "validation": {
                        "maxLength": 500
                    }
                },
                "redirect_uris": {
                    "type": "array",
                    "required": false,
                    "ui_type": "tags",
                    "label": "Redirect URIs",
                    "description": "URI di redirect per client OAuth2",
                    "validation": {
                        "itemType": "string"
                    }
                },
                "scopes": {
                    "type": "array",
                    "required": false,
                    "ui_type": "tags",
                    "label": "Scopes",
                    "description": "Permessi richiesti dal client",
                    "validation": {
                        "itemType": "string"
                    }
                },
                "tenant_id": {
                    "type": "string",
                    "required": false,
                    "ui_type": "text",
                    "label": "Tenant ID",
                    "description": "ID tenant per multi-tenancy"
                },
                "is_active": {
                    "type": "boolean",
                    "required": false,
                    "ui_type": "checkbox",
                    "label": "Active",
                    "description": "Se il client è attivo",
                    "default": true
                },
                "expires_at": {
                    "type": "string",
                    "required": false,
                    "ui_type": "datetime-local",
                    "label": "Expiration Date",
                    "description": "Data di scadenza del client"
                },
                "kb_config": {
                    "type": "object",
                    "required": false,
                    "ui_type": "json",
                    "label": "KB Configuration",
                    "description": "Configurazione Knowledge Base per il client",
                    "default": {
                        "universal_kbs_assigned": [],
                        "can_create_universal_kb": false,
                        "max_universal_kbs": 5,
                        "user_kb_assignment_mode": "default",
                        "default_user_kb_config": {
                            "inherit_all_universal_kbs": true,
                            "universal_kb_access_level": "read",
                            "personal_kb_enabled": true,
                            "personal_kb_max_size_mb": 100,
                            "personal_kb_max_documents": 50
                        },
                        "custom_user_kb_assignments": {}
                    }
                },
                "ingestion_config": {
                    "type": "object",
                    "required": false,
                    "ui_type": "json",
                    "label": "Ingestion Configuration",
                    "description": "Setting di ingestion dedicati per il client",
                    "default": {
                        "enabled": true,
                        "max_documents_per_day": 100,
                        "max_document_size_mb": 10,
                        "allowed_formats": [
                            "pdf",
                            "docx",
                            "txt",
                            "md"
                        ],
                        "chunk_size": 512,
                        "chunk_overlap": 50,
                        "embedding_model": "default"
                    }
                },
                "model_config": {
                    "type": "object",
                    "required": false,
                    "ui_type": "json",
                    "label": "Model Configuration",
                    "description": "Modelli LLM assegnati al client",
                    "default": {
                        "allowed_models": [
                            "tinyllama"
                        ],
                        "default_model": "tinyllama",
                        "max_tokens_per_request": 4096,
                        "temperature_range": {
                            "min": 0.0,
                            "max": 1.0
                        },
                        "rate_limit_requests_per_minute": 60
                    }
                },
                "user_limits": {
                    "type": "object",
                    "required": false,
                    "ui_type": "json",
                    "label": "User Limits",
                    "description": "Limiti utenti per il client",
                    "default": {
                        "max_users": 100,
                        "current_users": 0,
                        "user_roles_allowed": [
                            "user",
                            "viewer"
                        ],
                        "max_concurrent_sessions_per_user": 3
                    }
                },
                "rag_config": {
                    "type": "object",
                    "required": false,
                    "ui_type": "json",
                    "label": "RAG Configuration",
                    "description": "Configurazione pipeline RAG",
                    "default": {
                        "pipeline": "standard",
                        "top_k": 5,
                        "similarity_threshold": 0.7,
                        "reranking_enabled": false,
                        "conversation_memory_enabled": true,
                        "web_search_enabled": false
                    }
                },
                "prompt_config": {
                    "type": "object",
                    "required": false,
                    "ui_type": "json",
                    "label": "Prompt Configuration",
                    "description": "System prompt e template dedicati",
                    "default": {
                        "identity": null,
                        "system_prompt": "",
                        "context_template": "Use the following context to answer the question:\n{context}",
                        "can_modify_system_prompt": false,
                        "can_modify_context_template": false,
                        "language": "it",
                        "response_style": "professional"
                    }
                },
                "authorization": {
                    "type": "object",
                    "required": false,
                    "ui_type": "json",
                    "label": "Authorization",
                    "description": "Endpoint e permessi autorizzati",
                    "default": {
                        "allowed_endpoints": [
                            "*"
                        ],
                        "denied_endpoints": []
                    }
                },
                "settings_permissions": {
                    "type": "object",
                    "required": false,
                    "ui_type": "json",
                    "label": "Settings Permissions",
                    "description": "Permessi di modifica configurazioni",
                    "default": {
                        "can_modify_ingestion_settings": false,
                        "can_modify_model_settings": false,
                        "can_modify_rag_settings": false
                    }
                },
                "client_policy": {
                    "type": "object",
                    "required": false,
                    "ui_type": "json",
                    "label": "Client Policy (v17.19)",
                    "description": "Per-client runtime policy. allowed_subagent_profiles must be either ['*'] (permit all), [] (deny-all), or a list of concrete profile names. Wildcard mix is rejected.",
                    "default": {
                        "allowed_subagent_profiles": []
                    }
                },
                "request_id": {
                    "type": "string",
                    "required": false,
                    "ui_type": "text",
                    "label": "Request ID",
                    "description": "ID richiesta (auto-generato se non fornito)"
                }
            },
            "returns": {
                "client_id": "string (UUID)",
                "client_secret": "string (generated secret, only returned once)",
                "client_name": "string",
                "client_type": "string",
                "description": "string",
                "redirect_uris": "array of strings",
                "scopes": "array of strings",
                "tenant_id": "string",
                "is_active": "boolean",
                "kb_config": "object",
                "ingestion_config": "object",
                "model_config": "object",
                "user_limits": "object",
                "rag_config": "object",
                "prompt_config": "object",
                "authorization": "object",
                "settings_permissions": "object",
                "client_policy": "object",
                "created_at": "string (ISO datetime)",
                "updated_at": "string (ISO datetime)",
                "expires_at": "string (ISO datetime)",
                "request_id": "string (tracking ID)"
            },
            "mcp_hints": {
                "read_only": false,
                "idempotent": false,
                "estimated_latency_ms": 300,
                "requires_session": true,
                "category": "admin"
            },
            "security": "admin",
            "scope": "system",
            "client_types": []
        },
        {
            "name": "list_clients",
            "description": "List all clients with optional filtering and pagination",
            "parameters": {
                "filter": "object (optional, {is_active: bool, client_type: str, scopes: [str], tenant_id: str})",
                "limit": "integer (optional, max results to return)",
