            "parameters": {
                "client_id": "string (required, UUID)",
                "client_name": "string (optional, 3-100 chars, must be unique)",
                "description": "string (optional, max 500 chars)",
                "redirect_uris": "array of strings (optional)",
                "scopes": "array of strings (optional)",
                "tenant_id": "string (optional)",
