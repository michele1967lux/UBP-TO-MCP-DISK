                    "ui_type": "json",
                    "label": "Chunks"
                },
                "compression_ratio": {
                    "type": "number",
                    "required": false,
                    "ui_type": "number",
                    "label": "Compression Ratio",
                    "description": "Target ratio (0.3 = 30% of original)",
                    "default": 0.5,
                    "validation": {
                        "min": 0.1,
                        "max": 0.9
                    }
                },
                "method": {
                    "type": "string",
                    "required": false,
                    "ui_type": "select",
                    "label": "Method",
                    "options": [
                        {
                            "label": "Extractive (fast)",
                            "value": "extractive"
                        },
                        {
                            "label": "Abstractive (LLM)",
                            "value": "abstractive"
                        },
                        {
                            "label": "Hybrid",
                            "value": "hybrid"
                        }
                    ],
                    "default": "extractive"
                }
            },
            "returns": {
                "compressed_chunks": "array",
                "original_tokens": "integer",
                "compressed_tokens": "integer",
