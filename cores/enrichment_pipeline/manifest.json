{
    "name": "enrichment_pipeline",
    "version": "1.0.0",
    "description": "Advanced RAG enrichment pipeline with reranking, query expansion, HyDE, compression, and chunk fusion",
    "author": "UBP Team",
    "module_type": "enrichment",
    "architecture": "3-file-pattern",
    "requires_redis": true,
    "requires_postgres": false,
    "requires_event_bus": true,
    "dependencies": {
        "modules": [],
        "optional_modules": [
            "inference_vllm",
            "inference_ollama_grok",
            "inference_openai_anthropic"
        ],
        "python_packages": [
            "sentence-transformers>=2.2.0",
            "torch>=2.0.0",
            "FlagEmbedding>=1.2.0"
        ],
        "redis_keys": [
            "ubp:enrichment:cache:*",
            "ubp:enrichment:stats:*"
        ],
        "notes": "Requires at least one inference module for query_expansion, HyDE, and abstractive compression. Configure via UBP_ENRICHMENT_LLM_MODULE. Reranking works without LLM."
    },
    "operations": [
        {
            "name": "initialize",
            "description": "Initialize enrichment pipeline and load models",
            "parameters": {
                "preload_models": {
                    "type": "boolean",
                    "required": false,
                    "ui_type": "checkbox",
                    "label": "Preload Models",
                    "description": "Load reranker model immediately",
                    "default": true
                }
            },
            "returns": {
                "status": "string",
                "module": "string",
                "reranker_loaded": "boolean",
                "reranker_model": "string",
                "device": "string",
                "pipeline_steps_available": "array"
            },
            "mcp_hints": {
                "read_only": false,
                "idempotent": false,
                "estimated_latency_ms": 100,
                "requires_session": true,
                "category": "admin"
            },
            "security": "none",
            "scope": "system",
            "client_types": []
        },
        {
            "name": "enrich_context",
            "description": "Full enrichment pipeline: query expansion, HyDE, rerank, fusion, compression, metadata",
            "parameters": {
                "query": {
                    "type": "string",
                    "required": true,
                    "ui_type": "textarea",
                    "label": "Query",
                    "description": "Original search query"
                },
                "chunks": {
                    "type": "array",
                    "required": true,
                    "ui_type": "json",
                    "label": "Chunks",
                    "description": "Retrieved chunks to enrich"
                },
                "pipeline_config": {
                    "type": "object",
                    "required": false,
                    "ui_type": "json",
                    "label": "Pipeline Config",
                    "description": "Override default pipeline steps",
                    "default": null
                },
                "chat_history": {
                    "type": "array",
                    "required": false,
                    "ui_type": "json",
                    "label": "Chat History",
                    "description": "Previous messages for context-aware enrichment"
                },
                "top_k": {
                    "type": "integer",
                    "required": false,
                    "ui_type": "number",
                    "label": "Top K",
                    "description": "Number of chunks to return after reranking",
                    "default": 5
                }
            },
            "returns": {
                "enriched_query": "string (if query expansion applied)",
                "enriched_chunks": "array of enriched chunks",
                "metadata_added": "object",
                "enrichment_applied": "array of step names",
                "stats": "{total_time_ms, step_times, chunks_before, chunks_after}"
            },
            "mcp_hints": {
                "read_only": true,
                "idempotent": true,
                "estimated_latency_ms": 1000,
                "requires_session": false,
                "category": "operations"
            },
            "security": "authenticated",
            "scope": "free",
            "client_types": []
        },
        {
            "name": "rerank",
            "description": "Rerank chunks using cross-encoder model",
            "parameters": {
                "query": {
                    "type": "string",
                    "required": true,
                    "ui_type": "textarea",
                    "label": "Query"
                },
                "chunks": {
                    "type": "array",
                    "required": true,
                    "ui_type": "json",
                    "label": "Chunks"
                },
                "top_k": {
                    "type": "integer",
                    "required": false,
                    "ui_type": "number",
                    "label": "Top K",
                    "default": 10
                },
                "return_scores": {
                    "type": "boolean",
                    "required": false,
                    "ui_type": "checkbox",
                    "label": "Return Scores",
                    "default": true
                }
            },
            "returns": {
                "reranked_chunks": "array with rerank_score added",
                "model_used": "string",
                "time_ms": "number"
            },
            "mcp_hints": {
                "read_only": true,
                "idempotent": true,
                "estimated_latency_ms": 500,
                "requires_session": false,
                "category": "operations"
            },
            "security": "authenticated",
            "scope": "free",
            "client_types": []
        },
        {
            "name": "expand_query",
            "description": "Generate query variations using LLM",
            "parameters": {
                "query": {
                    "type": "string",
                    "required": true,
                    "ui_type": "textarea",
                    "label": "Query"
                },
                "num_variants": {
                    "type": "integer",
                    "required": false,
                    "ui_type": "number",
                    "label": "Number of Variants",
                    "default": 3,
                    "validation": {
                        "min": 1,
                        "max": 10
                    }
                },
                "chat_history": {
                    "type": "array",
                    "required": false,
                    "ui_type": "json",
                    "label": "Chat History"
                },
                "expansion_type": {
                    "type": "string",
                    "required": false,
                    "ui_type": "select",
                    "label": "Expansion Type",
                    "options": [
                        {
                            "label": "Semantic Variants",
                            "value": "semantic"
                        },
                        {
                            "label": "Keyword Extraction",
                            "value": "keywords"
                        },
                        {
                            "label": "Question Reformulation",
                            "value": "reformulate"
                        },
                        {
                            "label": "All Types",
                            "value": "all"
                        }
                    ],
                    "default": "semantic"
                }
            },
            "returns": {
                "original_query": "string",
                "expanded_queries": "array of variant queries",
                "combined_query": "string (merged for retrieval)",
                "time_ms": "number"
            },
            "mcp_hints": {
                "read_only": true,
                "idempotent": true,
                "estimated_latency_ms": 800,
                "requires_session": false,
                "category": "operations"
            },
            "security": "authenticated",
            "scope": "free",
            "client_types": []
        },
        {
            "name": "generate_hyde",
            "description": "Generate Hypothetical Document Embedding (HyDE)",
            "parameters": {
                "query": {
                    "type": "string",
                    "required": true,
                    "ui_type": "textarea",
                    "label": "Query"
                },
                "document_type": {
                    "type": "string",
                    "required": false,
                    "ui_type": "select",
                    "label": "Document Type",
