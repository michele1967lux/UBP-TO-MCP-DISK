                        {
                            "label": "Generic Answer",
                            "value": "answer"
                        },
                        {
                            "label": "Technical Documentation",
                            "value": "technical"
                        },
                        {
                            "label": "FAQ Entry",
                            "value": "faq"
                        },
                        {
                            "label": "Article Excerpt",
                            "value": "article"
                        }
                    ],
                    "default": "answer"
                },
                "format_type": {
                    "type": "string",
                    "required": false,
                    "ui_type": "select",
                    "label": "Format Type",
                    "description": "Alias for document_type (hyde_pipeline convention)",
                    "options": [
                        {
                            "label": "Generic Answer",
                            "value": "answer"
                        },
                        {
                            "label": "Technical Documentation",
                            "value": "technical"
                        },
                        {
                            "label": "FAQ Entry",
                            "value": "faq"
                        },
                        {
                            "label": "Article Excerpt",
