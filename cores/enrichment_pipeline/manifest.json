            "mcp_hints": {
                "read_only": true,
                "idempotent": true,
                "estimated_latency_ms": 1500,
                "requires_session": false,
                "category": "operations"
            },
            "security": "authenticated",
            "scope": "free",
            "client_types": []
        },
        {
            "name": "generate_investigative",
            "description": "Generate investigative search questions (v2.2.2 - FEAT-INVEST-001). Instead of generating a hypothetical answer (HyDE), generates specific search questions that would lead to finding the answer. Avoids hallucination on unknown terms.",
            "parameters": {
                "query": {
                    "type": "string",
                    "required": true,
                    "ui_type": "textarea",
                    "label": "Query",
                    "description": "Original user query to decompose"
                },
                "num_questions": {
                    "type": "integer",
                    "required": false,
                    "ui_type": "number",
                    "label": "Number of Questions",
                    "description": "Number of investigative questions to generate",
                    "default": 5,
                    "validation": {
                        "min": 1,
                        "max": 10
                    }
                },
                "investigation_type": {
                    "type": "string",
                    "required": false,
                    "ui_type": "select",
                    "label": "Investigation Type",
                    "description": "Type of investigation approach",
                    "options": [
                        {
                            "label": "Auto-detect",
                            "value": "auto"
                        },
                        {
                            "label": "Default",
                            "value": "default"
                        },
                        {
                            "label": "AI/ML Systems",
                            "value": "ai_ml"
                        },
                        {
                            "label": "System Administration",
                            "value": "system_admin"
                        },
                        {
                            "label": "API Integration",
                            "value": "api_integration"
                        },
                        {
                            "label": "Technical",
                            "value": "technical"
                        },
                        {
                            "label": "Conceptual",
                            "value": "conceptual"
                        },
                        {
                            "label": "Troubleshooting",
                            "value": "troubleshooting"
                        }
                    ],
                    "default": "auto"
                }
            },
            "returns": {
                "investigative_questions": "array of generated search questions",
                "original_query": "string",
                "time_ms": "number"
            },
            "mcp_hints": {
                "read_only": true,
                "idempotent": true,
                "estimated_latency_ms": 2000,
                "requires_session": false,
                "category": "operations"
            },
            "security": "authenticated",
            "scope": "free",
            "client_types": []
        },
        {
            "name": "optimize_query",
            "description": "FEAT-ARCH-2.2: Optimize query for retrieval using HyDE, Query Expansion, and/or Investigative Decomposition. Returns a list of optimized search queries for multi-retrieval.",
            "parameters": {
                "query": {
                    "type": "string",
                    "required": true,
                    "ui_type": "textarea",
                    "label": "Query",
                    "description": "Original user query to optimize"
                },
                "hyde_enabled": {
                    "type": "boolean",
                    "required": false,
                    "ui_type": "checkbox",
                    "label": "Enable HyDE",
                    "description": "Generate hypothetical document embedding",
                    "default": true
                },
                "expansion_enabled": {
                    "type": "boolean",
                    "required": false,
                    "ui_type": "checkbox",
                    "label": "Enable Expansion",
                    "description": "Generate query variants",
                    "default": true
                },
                "num_variants": {
                    "type": "integer",
                    "required": false,
                    "ui_type": "number",
                    "label": "Number of Variants",
                    "description": "Number of expansion variants to generate",
                    "default": 3,
                    "validation": {
                        "min": 1,
                        "max": 5
                    }
                },
                "hyde_document_type": {
                    "type": "string",
                    "required": false,
                    "ui_type": "select",
                    "label": "HyDE Document Type",
                    "options": [
                        {
                            "label": "Generic Answer",
                            "value": "answer"
                        },
                        {
                            "label": "Technical Documentation",
                            "value": "technical"
                        },
                        {
                            "label": "FAQ Entry",
                            "value": "faq"
                        },
                        {
                            "label": "Troubleshooting Guide",
                            "value": "troubleshooting"
                        }
                    ],
                    "default": "answer"
                },
                "investigative_enabled": {
                    "type": "boolean",
                    "required": false,
                    "ui_type": "checkbox",
                    "label": "Enable Investigative",
                    "description": "Generate investigative search questions (v2.2.2 - alternative to HyDE)",
                    "default": false
                },
                "num_questions": {
                    "type": "integer",
                    "required": false,
                    "ui_type": "number",
                    "label": "Number of Questions",
                    "description": "Number of investigative questions to generate",
                    "default": 5,
                    "validation": {
                        "min": 1,
                        "max": 10
                    }
                }
            },
            "returns": {
                "search_queries": "array of optimized search queries",
                "original_query": "string",
                "hyde_document": "string or null",
                "expanded_queries": "array of expansion variants",
                "investigative_questions": "array of investigative questions (v2.2.2)",
                "optimization_applied": "array of applied optimization types",
                "queries_count": "integer",
                "time_ms": "number"
