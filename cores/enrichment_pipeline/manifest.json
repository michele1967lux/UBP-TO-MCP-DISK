                "idempotent": true,
                "estimated_latency_ms": 600,
                "requires_session": false,
                "category": "operations"
            },
            "security": "authenticated",
            "scope": "free",
            "client_types": []
        },
        {
            "name": "extract_filters",
            "description": "Extract metadata filters from natural language query (Query-to-Filter). Converts user intent into Qdrant-compatible filter conditions.",
            "parameters": {
                "query": {
                    "type": "string",
                    "required": true,
                    "ui_type": "textarea",
                    "label": "Query",
                    "description": "Natural language query with filter intent (e.g., 'only from document X')"
                }
            },
            "returns": {
                "filters": "object (Qdrant-compatible filter dict) or null",
                "entities": "object with extracted entity values",
                "applied_fields": "array of metadata fields used",
                "confidence": "number (0-1) confidence score",
                "raw_response": "string (raw LLM response for debug)"
            },
            "mcp_hints": {
                "read_only": true,
                "idempotent": true,
                "estimated_latency_ms": 300,
