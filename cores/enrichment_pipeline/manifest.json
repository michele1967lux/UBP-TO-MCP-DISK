            },
            "security": "authenticated",
            "scope": "free",
            "client_types": []
        },
        {
            "name": "fuse_chunks",
            "description": "Merge overlapping or semantically similar chunks",
            "parameters": {
                "chunks": {
                    "type": "array",
                    "required": true,
                    "ui_type": "json",
                    "label": "Chunks"
                },
                "strategy": {
                    "type": "string",
                    "required": false,
                    "ui_type": "select",
                    "label": "Fusion Strategy",
                    "options": [
                        {
                            "label": "Overlap Detection",
                            "value": "overlap"
                        },
                        {
                            "label": "Semantic Similarity",
                            "value": "semantic"
                        },
                        {
                            "label": "Adjacent (same doc)",
                            "value": "adjacent"
                        },
                        {
                            "label": "All Strategies",
                            "value": "all"
                        }
                    ],
                    "default": "all"
                },
                "overlap_threshold": {
                    "type": "number",
                    "required": false,
                    "ui_type": "number",
                    "label": "Overlap Threshold",
                    "default": 0.3
                },
                "semantic_threshold": {
                    "type": "number",
                    "required": false,
                    "ui_type": "number",
                    "label": "Semantic Threshold",
                    "default": 0.93
                }
            },
            "returns": {
                "fused_chunks": "array",
                "chunks_before": "integer",
                "chunks_after": "integer",
                "fusions_applied": "array of {type, merged_ids}"
