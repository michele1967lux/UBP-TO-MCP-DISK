  "events": {
    "publishes": [
      {
        "event": "hyde.initialized",
        "description": "Module initialized successfully",
        "payload": {
          "module": "string",
          "status": "string"
        }
      },
      {
        "event": "hyde.pipeline.started",
        "description": "Pipeline execution started",
