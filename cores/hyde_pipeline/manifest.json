      "admin_only": false,
      "mcp_hints": {
        "read_only": true,
        "idempotent": true,
        "estimated_latency_ms": 1500,
        "requires_session": false,
        "category": "operations"
      },
      "security": "authenticated",
      "scope": "free",
      "client_types": []
    },
