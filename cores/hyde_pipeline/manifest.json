{
  "name": "hyde_pipeline",
  "version": "1.0.0",
  "description": "Enterprise HyDE (Hypothetical Document Embedding) Engine for improved RAG retrieval",
  "architecture": "3-file-pattern",
  "category": "core",
  "production_ready": true,
  "author": "UBP Team",
  "license": "proprietary",
  "repository": "internal",
  "features": [
    "Multi-format document generation",
    "Domain-adaptive templates",
    "Ensemble HyDE with diversity",
    "Iterative refinement",
    "Hallucination detection",
    "Semantic chunking",
    "Quality assurance scoring",
    "Cross-lingual support (EN/IT)",
    "Redis caching with semantic matching",
    "Session management",
    "Worker pool parallelism",
    "Comprehensive metrics"
  ],
  "dependencies": {
    "required": [],
    "optional": [
      {
        "module": "inference_vllm",
        "purpose": "vLLM inference backend"
      },
      {
        "module": "inference_ollama_grok",
        "purpose": "Ollama/Grok inference backend"
      },
      {
        "module": "inference_openai_anthropic",
        "purpose": "OpenAI/Anthropic API backend"
      }
    ]
  },
  "redis_keys": {
    "patterns": [
      "ubp:{env}:hyde:cache:hyde:{hash}",
      "ubp:{env}:hyde:cache:qa:{hash}",
      "ubp:{env}:hyde:cache:chunks:{hash}",
      "ubp:{env}:hyde:session:{session_id}",
      "ubp:{env}:hyde:stats:*"
    ],
    "description": "Environment-isolated keys with {env} = dev|test|prod"
  },
  "formats": {
    "answer": {
      "description": "Direct answer format simulating knowledge base response",
      "temperature": 0.5,
      "max_length": 400
    },
    "technical_doc": {
      "description": "Technical documentation style with sections and details",
      "temperature": 0.3,
      "max_length": 600
    },
    "faq": {
      "description": "FAQ entry format with clear Q&A structure",
      "temperature": 0.4,
      "max_length": 350
    },
    "code_snippet": {
      "description": "Code-focused with examples and comments",
      "temperature": 0.2,
      "max_length": 500
    },
    "tutorial": {
      "description": "Step-by-step tutorial format",
      "temperature": 0.4,
      "max_length": 700
    },
    "troubleshooting": {
      "description": "Problem-solution format for debugging",
      "temperature": 0.3,
      "max_length": 500
    },
    "article": {
      "description": "Article excerpt format with narrative flow",
      "temperature": 0.6,
      "max_length": 800
    }
  },
  "domains": {
    "ai_ml": {
      "description": "Machine Learning, Deep Learning, LLMs, RAG, Embeddings",
      "preferred_formats": [
        "technical_doc",
        "code_snippet",
        "answer"
      ]
    },
    "devops": {
      "description": "Docker, Kubernetes, CI/CD, Infrastructure as Code",
      "preferred_formats": [
        "tutorial",
        "troubleshooting",
        "code_snippet"
      ]
    },
    "api_integration": {
      "description": "REST APIs, GraphQL, Authentication, Webhooks",
      "preferred_formats": [
        "code_snippet",
        "technical_doc",
        "faq"
      ]
    },
    "database": {
      "description": "SQL, NoSQL, Query Optimization, Data Modeling",
      "preferred_formats": [
        "code_snippet",
        "technical_doc",
        "troubleshooting"
      ]
    },
    "security": {
      "description": "Authentication, Encryption, Vulnerabilities, Compliance",
      "preferred_formats": [
        "technical_doc",
        "troubleshooting",
        "faq"
      ]
    },
    "cloud": {
      "description": "AWS, Azure, GCP, Serverless, Cloud Architecture",
      "preferred_formats": [
        "tutorial",
        "technical_doc",
        "troubleshooting"
      ]
    },
    "general": {
      "description": "General technical and conceptual queries",
      "preferred_formats": [
        "answer",
        "faq",
        "article"
      ]
    }
  },
  "operations": [
    {
      "name": "initialize",
      "description": "Initialize all HyDE components and start worker pool",
      "parameters": {},
      "returns": {
        "status": "string",
        "components": "object"
      },
      "admin_only": false,
      "idempotent": true,
      "mcp_hints": {
        "read_only": false,
        "idempotent": false,
        "estimated_latency_ms": 100,
        "requires_session": true,
        "category": "admin"
      },
      "security": "none",
      "scope": "system",
      "client_types": []
    },
    {
      "name": "generate_hyde",
      "description": "Full HyDE pipeline execution with session management",
      "parameters": {
        "query": {
          "type": "string",
          "required": true,
          "description": "User's query",
          "ui_type": "textarea",
          "min_length": 3,
          "max_length": 2000
        },
        "format_type": {
          "type": "string",
          "required": false,
          "description": "Document format override",
          "ui_type": "select",
          "options": [
            "answer",
            "technical_doc",
            "faq",
            "code_snippet",
            "tutorial",
            "troubleshooting",
            "article"
          ]
        },
        "domain": {
          "type": "string",
          "required": false,
          "default": "auto",
          "description": "Domain override or 'auto' for detection",
          "ui_type": "select",
          "options": [
            "auto",
            "ai_ml",
            "devops",
            "api_integration",
            "database",
            "security",
            "cloud",
            "general"
          ]
        },
        "language": {
          "type": "string",
          "required": false,
          "default": "auto",
          "description": "Language code or 'auto' for detection",
          "ui_type": "select",
          "options": [
            "auto",
            "en",
            "it"
          ]
        },
        "num_documents": {
          "type": "integer",
          "required": false,
          "default": 1,
          "description": "Number of documents (for ensemble)",
          "ui_type": "number",
          "min": 1,
          "max": 5
        },
        "enable_refinement": {
          "type": "boolean",
          "required": false,
          "default": true,
          "description": "Enable iterative refinement",
          "ui_type": "toggle"
        },
        "enable_ensemble": {
          "type": "boolean",
          "required": false,
          "default": false,
          "description": "Enable ensemble generation",
          "ui_type": "toggle"
        },
        "max_length": {
          "type": "integer",
          "required": false,
          "description": "Maximum document length",
          "ui_type": "number",
          "min": 100,
          "max": 1000
        },
        "session_id": {
          "type": "string",
          "required": false,
          "description": "Existing session ID for continuity"
        },
        "pipeline_config": {
          "type": "object",
          "required": false,
          "description": "Pipeline step configuration override"
        }
      },
      "returns": {
        "session_id": "string",
        "query": "string",
        "document": "object",
        "chunks": "array",
        "classification": "object",
        "quality_assessment": "object",
        "hallucination_check": "object",
        "refinement_applied": "boolean",
        "time_ms": "number",
        "step_times": "object"
