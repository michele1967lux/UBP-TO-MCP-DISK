{
  "name": "graph_rag",
  "version": "1.0.0",
  "description": "Enterprise Knowledge Graph RAG Engine with entity/relation extraction, graph construction, and graph-based retrieval",
  "architecture": "3-file-pattern",
  "category": "core",
  "production_ready": true,
  "features": [
    "Entity extraction with LLM",
    "Relation extraction with evidence spans",
    "Knowledge graph construction",
    "Entity merge and deduplication",
    "Graph-based retrieval",
    "Multi-hop path finding",
    "Subgraph extraction",
    "Subgraph reasoning",
    "PageRank and centrality",
    "Cross-lingual support (EN/IT)",
    "Multiple export formats",
    "Redis caching",
    "Session management"
  ],
  "entity_types": [
    {
      "type": "person",
      "description": "People, individuals"
    },
    {
      "type": "organization",
      "description": "Companies, institutions"
    },
    {
      "type": "location",
      "description": "Places, addresses"
    },
    {
      "type": "date",
      "description": "Dates, time periods"
    },
    {
      "type": "technology",
      "description": "Technologies, tools"
    },
    {
      "type": "concept",
      "description": "Abstract concepts"
    },
    {
      "type": "product",
      "description": "Products, services"
    },
    {
      "type": "event",
      "description": "Events, occurrences"
    },
    {
      "type": "quantity",
      "description": "Numbers, measurements"
    },
    {
      "type": "custom",
      "description": "Custom entity types"
    }
  ],
  "relation_types": [
    {
      "type": "works_for",
      "description": "Employment relationship"
    },
    {
      "type": "located_in",
      "description": "Location relationship"
    },
    {
      "type": "part_of",
      "description": "Part-whole relationship"
    },
    {
      "type": "created_by",
      "description": "Creator relationship"
    },
    {
      "type": "used_by",
      "description": "Usage relationship"
    },
    {
      "type": "related_to",
      "description": "General relationship"
    },
    {
      "type": "depends_on",
      "description": "Dependency relationship"
    },
    {
      "type": "causes",
      "description": "Causal relationship"
    },
    {
      "type": "has_property",
      "description": "Property relationship"
    },
    {
      "type": "instance_of",
      "description": "Instance relationship"
    },
    {
      "type": "subclass_of",
      "description": "Subclass relationship"
    },
    {
      "type": "custom",
      "description": "Custom relation types"
    }
  ],
  "retrieval_strategies": [
    {
      "strategy": "entity_centric",
      "description": "Search starting from matched entities"
    },
    {
      "strategy": "relation_guided",
      "description": "Follow specific relation types"
    },
    {
      "strategy": "path_based",
      "description": "Find paths between entities"
    },
    {
      "strategy": "subgraph",
      "description": "Extract local neighborhood"
    },
    {
      "strategy": "hybrid",
      "description": "Combine graph and vector search"
    }
  ],
  "operations": [
