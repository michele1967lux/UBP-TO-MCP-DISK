        },
        "max_hops": {
          "type": "integer",
          "required": false,
          "default": 2,
          "min": 1,
          "max": 5
        },
        "max_subgraph_nodes": {
          "type": "integer",
          "required": false,
          "default": 100,
          "min": 10,
          "max": 500
        },
        "retrieval_strategy": {
          "type": "string",
          "required": false,
          "default": "hybrid",
