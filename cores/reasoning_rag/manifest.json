  "events": {
    "publishes": [
      {
        "event": "reasoning.initialized",
        "description": "Module initialized successfully"
      },
      {
        "event": "reasoning.completed",
        "description": "Reasoning pipeline completed",
        "payload": {
          "session_id": "string",
          "strategy": "string",
          "confidence": "number",
          "time_ms": "number"
        }
      },
      {
        "event": "reasoning.self_ask.completed",
        "description": "Self-Ask strategy completed"
      },
      {
        "event": "reasoning.cot.completed",
        "description": "Chain-of-Thought strategy completed"
      },
      {
        "event": "reasoning.evidence.completed",
        "description": "Evidence attribution completed"
      },
      {
        "event": "reasoning.verification.completed",
        "description": "Verification completed"
      },
      {
        "event": "reasoning.contradiction.detected",
        "description": "Contradiction detected between sources"
      },
      {
        "event": "reasoning.shutdown",
        "description": "Module shutdown completed"
      }
    ]
  },
  "query_complexity": {
    "levels": {
      "simple": {
        "threshold": 0.3,
        "description": "Single-fact queries, definitions",
        "default_strategy": "direct"
      },
      "moderate": {
        "threshold": 0.6,
        "description": "Queries requiring some reasoning",
        "default_strategy": "chain_of_thought"
      },
      "complex": {
        "threshold": 0.8,
        "description": "Multi-step reasoning required",
        "default_strategy": "chain_of_thought"
      },
      "multi_hop": {
        "threshold": 1.0,
        "description": "Multiple information sources needed",
        "default_strategy": "self_ask"
      }
    }
  },
  "query_intents": {
    "factual": "What, who, when, where questions",
    "explanatory": "How and why questions",
    "comparative": "Comparison between entities",
    "procedural": "Step-by-step instructions",
    "causal": "Cause and effect relationships",
    "definitional": "Definition requests",
    "evaluative": "Opinion or recommendation requests"
  },
  "verification_statuses": {
    "verified": "Claim confirmed by multiple sources",
    "partially_verified": "Claim partially supported",
    "unverified": "Insufficient sources to verify",
    "contradicted": "Sources contradict the claim"
  },
  "module_type": "rag"
}
