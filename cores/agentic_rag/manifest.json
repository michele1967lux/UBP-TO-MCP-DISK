  "events": {
    "publishes": [
      {
        "event": "agentic.initialized",
        "description": "Module initialized"
      },
      {
        "event": "agentic.query.started",
        "description": "Query execution started"
      },
      {
        "event": "agentic.step.completed",
        "description": "Reasoning step completed"
      },
      {
        "event": "agentic.tool.called",
        "description": "Tool invocation"
      },
      {
        "event": "agentic.query.completed",
        "description": "Query completed"
      },
      {
        "event": "agentic.shutdown",
        "description": "Module shutdown"
      }
    ]
  },
  "dependencies": {
    "optional": [
      {
        "module": "inference_ollama_grok",
        "purpose": "LLM for reasoning"
      },
      {
        "module": "retrieval_strategy",
        "purpose": "Document retrieval tool"
      },
      {
        "module": "graph_rag",
        "purpose": "Knowledge graph tool"
      },
      {
        "module": "web_search",
        "purpose": "Web search tool"
      }
    ]
  },
  "module_type": "rag"
}
