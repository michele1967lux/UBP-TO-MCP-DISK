      "admin_only": false,
      "mcp_hints": {
        "read_only": false,
        "idempotent": false,
        "estimated_latency_ms": 15000,
        "requires_session": true,
        "category": "agent"
      },
      "security": "authenticated",
      "scope": "free",
      "client_types": []
    },
    {
