{
  "name": "streaming_rag",
  "version": "1.0.0",
  "description": "Streaming Response Generation Engine for RAG pipelines",
  "architecture": "3-file-pattern",
  "category": "core",
  "production_ready": true,
  "features": [
    "Token-by-token streaming",
    "Multiple output formats (SSE, WebSocket, JSONL, Text)",
    "Server-Sent Events with keepalive",
    "WebSocket bidirectional communication",
    "Token buffering with configurable flush",
    "Backpressure handling",
    "Progress events",
    "Source document streaming",
    "Timing metrics (TTFT, TPS)",
    "Graceful cancellation",
    "Error recovery with partial results",
    "Connection management",
    "Rate limiting",
    "Cross-module integration"
  ],
  "output_formats": [
    {
      "format": "sse",
      "content_type": "text/event-stream",
      "description": "Server-Sent Events for HTTP streaming"
    },
    {
      "format": "websocket",
      "content_type": "application/json",
      "description": "WebSocket bidirectional streaming"
    },
    {
      "format": "jsonl",
      "content_type": "application/x-ndjson",
      "description": "JSON Lines newline-delimited format"
    },
    {
      "format": "text",
      "content_type": "text/plain",
      "description": "Plain text token stream"
    },
    {
      "format": "generator",
      "content_type": "application/octet-stream",
      "description": "Python async generator"
    }
  ],
  "event_types": [
    {
      "type": "stream_start",
      "description": "Stream started"
    },
    {
      "type": "stream_end",
      "description": "Stream ended"
    },
    {
      "type": "stream_error",
      "description": "Stream error occurred"
    },
    {
      "type": "retrieval_start",
      "description": "Retrieval phase started"
    },
    {
      "type": "retrieval_progress",
      "description": "Retrieval progress update"
    },
    {
      "type": "retrieval_complete",
      "description": "Retrieval completed"
    },
    {
      "type": "source_found",
      "description": "Source document found"
    },
    {
      "type": "generation_start",
      "description": "Generation phase started"
    },
    {
      "type": "token",
      "description": "Single token generated"
    },
    {
      "type": "chunk",
      "description": "Multiple tokens as chunk"
    },
    {
      "type": "generation_progress",
      "description": "Generation progress update"
    },
    {
      "type": "generation_complete",
      "description": "Generation completed"
    },
    {
      "type": "metadata",
      "description": "Metadata event"
    },
    {
      "type": "timing",
      "description": "Timing information"
    },
    {
      "type": "heartbeat",
      "description": "Keepalive heartbeat"
    },
    {
      "type": "done",
      "description": "Stream completed successfully"
    }
  ],
