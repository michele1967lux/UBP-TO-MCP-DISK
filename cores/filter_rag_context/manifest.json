{
    "name": "filter_rag_context",
    "version": "2.0.0",
    "description": "Chunk filtering and ranking for RAG context — pure logic, zero I/O",
    "author": "UBP Team",
    "module_type": "rag",
    "architecture": "3-file-pattern",
    "requires_redis": false,
    "requires_postgres": false,
    "requires_event_bus": false,
    "operations": [
        {
            "name": "filter_context",
            "description": "Filter and rank RAG chunks by relevance, quality, and diversity",
            "mcp_hints": {
                "read_only": true,
                "idempotent": true,
                "estimated_latency_ms": 200,
                "requires_session": false,
                "category": "knowledge"
            },
            "parameters": {
                "chunks": "List[Dict] (required, retrieved chunks with text/score/source_id/chunk_id)",
                "query": "string (required, user query)",
                "config_override": "Dict (optional, per-request threshold overrides)"
            },
            "returns": {
                "kept": "List[ChunkVerdict]",
                "dropped": "List[ChunkVerdict]",
                "stats": "FilterStats",
                "fallback_triggered": "boolean"
            },
            "security": "authenticated",
            "scope": "free",
            "client_types": []
        },
        {
            "name": "health_check",
            "description": "Module health status",
            "mcp_hints": {
                "read_only": true,
                "idempotent": true,
                "estimated_latency_ms": 75,
                "requires_session": false,
                "category": "admin"
            },
            "parameters": {},
            "returns": {
                "module": "string",
                "version": "string",
                "status": "string",
                "shadow_mode": "boolean"
            },
            "security": "none",
            "scope": "system",
            "client_types": []
        }
    ],
    "event_publications": [],
    "dependencies": {
        "modules": [],
        "redis_keys": []
    },
    "config_file": "config.json",
    "config_schema": {
        "enabled": {
            "type": "boolean",
            "required": true
        },
        "shadow_mode": {
            "type": "boolean"
        },
        "min_chars_hard": {
            "type": "integer",
            "min": 1
        },
        "min_score_hard": {
            "type": "number",
            "min": 0.0,
            "max": 1.0
        },
        "min_score_soft": {
            "type": "number",
            "min": 0.0,
            "max": 1.0
        },
        "min_chars_soft": {
            "type": "integer",
            "min": 1
        },
        "boilerplate_penalty": {
            "type": "number",
            "min": 0.0,
            "max": 1.0
        },
        "truncation_penalty": {
            "type": "number",
            "min": 0.0,
            "max": 1.0
        },
        "keyword_bonus": {
            "type": "number",
            "min": 0.0,
            "max": 1.0
        },
        "relevance_floor": {
            "type": "number",
            "min": 0.0,
            "max": 1.0
        },
        "low_confidence_threshold": {
            "type": "number",
            "min": 0.0,
            "max": 1.0
        },
        "diversity_cap_per_source": {
            "type": "integer",
            "min": 1
        },
        "max_chunks": {
            "type": "integer",
            "min": 1
        },
        "max_total_chars": {
            "type": "integer",
            "min": 100
        },
        "min_output_guarantee": {
            "type": "integer",
            "min": 0
        }
    },
    "production_ready": false,
    "tools": [
        {
            "name": "filter_context",
            "operation": "filter_context",
            "tool_type": "step",
            "description": "Filter and rank RAG chunks by relevance, quality, and diversity",
            "providers": [],
            "input_schema": {
                "chunks": {
                    "type": "array",
                    "required": true
                },
                "query": {
                    "type": "string",
                    "required": true
                }
            },
            "output_schema": {
                "kept": {
                    "type": "array"
                },
                "dropped": {
                    "type": "array"
                },
                "stats": {
                    "type": "object"
                }
            },
            "timeout": 5.0,
            "mcp_hints": {
                "read_only": true,
                "idempotent": true,
                "estimated_latency_ms": 500,
                "requires_session": false,
                "category": "knowledge"
            }
        },
        {
            "name": "search_kb_light",
            "operation": "search_kb_light",
            "tool_type": "tool",
            "description": "Quick check if the user's knowledge base has relevant documents. Returns collection affinity and top-3 scores without full content.",
            "providers": [],
            "input_schema": {
                "query": {
                    "type": "string",
                    "required": true
                }
            },
            "output_schema": {
                "has_relevant_content": {
                    "type": "boolean"
                },
                "collections_matched": {
                    "type": "array"
                },
                "top_matches": {
                    "type": "array"
                }
            },
            "timeout": 5.0,
            "mcp_hints": {
                "read_only": true,
                "idempotent": true,
                "estimated_latency_ms": 500,
                "requires_session": false,
                "category": "knowledge"
            }
        }
    ]
}
