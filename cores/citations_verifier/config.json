{
  "_comment": "Citations Verifier — configuration with ENV override support",
  "_version": "1.0.0",

  "verification": {
    "_comment": "How to verify claims",
    "enabled": "${UBP_CITATIONS__ENABLED:-true}",
    "default_depth": "${UBP_CITATIONS__DEFAULT_DEPTH:-standard}",
    "max_claims_per_document": "${UBP_CITATIONS__MAX_CLAIMS:-50}",
    "max_parallel_verifications": "${UBP_CITATIONS__MAX_PARALLEL:-5}",
    "claim_min_length": "${UBP_CITATIONS__CLAIM_MIN_LEN:-15}",
    "confidence_threshold_supported": "${UBP_CITATIONS__CONF_SUPPORTED:-0.75}",
    "confidence_threshold_partial": "${UBP_CITATIONS__CONF_PARTIAL:-0.45}",
    "web_search_per_claim": "${UBP_CITATIONS__SEARCHES_PER_CLAIM:-2}",
    "timeout_per_claim_s": "${UBP_CITATIONS__CLAIM_TIMEOUT:-30}"
  },

  "trust_lists": {
    "_comment": "Trust list management and persistence",
    "storage_backend": "${UBP_CITATIONS__STORAGE:-redis}",
    "redis_prefix": "${UBP_CITATIONS__REDIS_PREFIX:-ubp:trust_list}",
    "json_backup_path": "${UBP_CITATIONS__JSON_BACKUP:-data/trust_lists}",
    "auto_backup_on_change": "${UBP_CITATIONS__AUTO_BACKUP:-true}",
    "default_trust_score": "${UBP_CITATIONS__DEFAULT_SCORE:-0.7}",
    "score_decay_days": "${UBP_CITATIONS__SCORE_DECAY_DAYS:-90}",
    "max_domains_per_list": "${UBP_CITATIONS__MAX_DOMAINS:-200}"
  },

  "discovery": {
    "_comment": "Auto-discovery of trusted sources",
    "enabled": "${UBP_CITATIONS__DISCOVERY_ENABLED:-true}",
    "searches_per_domain": "${UBP_CITATIONS__DISC_SEARCHES:-5}",
    "min_appearances": "${UBP_CITATIONS__DISC_MIN_APPEARANCES:-3}",
    "authority_signals": "${UBP_CITATIONS__DISC_SIGNALS:-tld,https,domain_age,academic_refs}",
    "auto_add_threshold": "${UBP_CITATIONS__DISC_AUTO_ADD:-0.85}",
    "cooldown_hours": "${UBP_CITATIONS__DISC_COOLDOWN:-24}"
  },

  "search_integration": {
    "_comment": "How trust lists integrate with web_search module",
    "filter_mode": "${UBP_CITATIONS__FILTER_MODE:-prioritize}",
    "max_sites_in_filter": "${UBP_CITATIONS__MAX_FILTER_SITES:-10}",
    "fallback_to_generic": "${UBP_CITATIONS__FALLBACK_GENERIC:-true}",
    "exclusive_domains": "${UBP_CITATIONS__EXCLUSIVE_DOMAINS:-}"
  },

