                "category": "operations"
            },
            "security": "authenticated",
            "scope": "free",
            "client_types": []
        },
        {
            "name": "multimodal_query",
            "description": "Query with both text and image for enhanced retrieval",
            "parameters": {
                "text": {
                    "type": "string",
                    "required": false
                },
                "image_source": {
                    "type": "string|bytes|object",
                    "required": false
                },
                "fusion_method": {
                    "type": "string",
                    "required": false,
                    "default": "average",
                    "options": [
                        "average",
                        "weighted",
                        "concat"
                    ]
                },
                "top_k": {
                    "type": "integer",
                    "required": false,
                    "default": 10
                }
            },
            "returns": {
                "items": "array",
                "fusion_method": "string",
                "time_ms": "number"
            },
            "mcp_hints": {
                "read_only": true,
                "idempotent": true,
                "estimated_latency_ms": 2000,
                "requires_session": false,
                "category": "operations"
            },
