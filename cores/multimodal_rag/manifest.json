    ],
    "event_subscriptions": [],
    "event_publications": [
        "multimodal.initialized",
        "multimodal.item_indexed",
        "multimodal.retrieval_completed",
        "multimodal.document_processed",
        "multimodal.shutdown"
    ],
    "retrieval_modes": {
        "hybrid": "Combined text and image search across all modalities",
        "text_to_image": "Find images matching text description",
        "image_to_text": "Find text describing an image",
        "image_to_image": "Find visually similar images",
        "unified": "Search unified embedding space"
    },
    "fusion_methods": {
        "early": "Concatenate features before similarity computation",
        "late": "Combine scores after individual retrievals",
        "hybrid": "Multi-stage fusion with filtering and reranking",
        "attention": "Cross-modal attention fusion"
    },
    "config_file": "config.json",
    "test_suite": "test_multimodal_rag.py",
    "production_ready": true,
    "hardware_requirements": {
        "gpu_recommended": true,
        "min_vram_gb": 4,
        "recommended_vram_gb": 8,
        "cpu_fallback": true
    }
}
