            "description": "Initialize citation manager",
            "parameters": {
                "default_style": {
                    "type": "string",
                    "required": false,
                    "default": "apa",
                    "options": [
                        "apa",
                        "mla",
                        "chicago",
                        "ieee",
                        "harvard",
                        "vancouver"
                    ]
                },
                "persist_path": {
                    "type": "string",
                    "required": false
                },
                "strict_validation": {
                    "type": "boolean",
                    "required": false,
                    "default": false
                }
            },
            "returns": {
                "status": "string",
                "module": "string",
                "version": "string",
                "default_style": "string",
                "citations_loaded": "integer"
