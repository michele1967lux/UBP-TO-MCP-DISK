{
  "name": "retrieval_strategy",
  "version": "1.0.0",
  "description": "Advanced Retrieval Strategies Engine with Hybrid, Hierarchical, Multi-Index, and Router-based retrieval",
  "architecture": "3-file-pattern",
  "category": "core",
  "production_ready": true,
  "features": [
    "Hybrid retrieval (BM25 + Vector)",
    "Reciprocal Rank Fusion (RRF)",
    "Weighted score fusion",
    "Hierarchical multi-level retrieval",
    "Parent-child chunk linking",
    "Context window expansion",
    "Multi-index parallel search",
    "LLM-based query routing",
    "Query classification",
    "Skip retrieval detection",
    "Score normalization",
    "Result deduplication",
    "Query caching",
    "Comprehensive metrics"
  ],
  "strategies": [
    {
      "name": "hybrid",
      "description": "Combines BM25 keyword search with vector semantic search",
      "use_cases": [
        "General factual queries",
        "Most common queries"
      ]
    },
    {
      "name": "hierarchical",
      "description": "Multi-level retrieval across document/section/paragraph",
      "use_cases": [
        "Complex analytical queries",
        "Context-heavy questions"
      ]
    },
    {
      "name": "multi_index",
      "description": "Search across multiple specialized indexes",
      "use_cases": [
        "Comparative queries",
        "Cross-domain questions"
      ]
    },
    {
      "name": "router",
      "description": "LLM-based dynamic strategy selection",
      "use_cases": [
        "Unknown query types",
        "Production systems"
      ]
    },
    {
      "name": "bm25",
      "description": "Pure keyword-based BM25 retrieval",
      "use_cases": [
        "Technical terms",
        "Exact matches"
      ]
    }
  ],
  "fusion_methods": [
    {
      "method": "rrf",
      "description": "Reciprocal Rank Fusion - position-based"
    },
    {
      "method": "weighted",
      "description": "Weighted score combination"
    },
    {
      "method": "max",
      "description": "Take maximum score per document"
    },
    {
      "method": "sum",
      "description": "Sum of normalized scores"
    },
    {
      "method": "dbsf",
      "description": "Distribution-Based Score Fusion"
    }
  ],
  "hierarchy_levels": [
    {
      "level": "document",
      "default_chunk_size": 4000,
      "description": "Full document context"
    },
    {
      "level": "section",
      "default_chunk_size": 1000,
      "description": "Section-level chunks"
    },
    {
      "level": "paragraph",
      "default_chunk_size": 300,
      "description": "Fine-grained paragraphs"
    }
  ],
  "operations": [
    {
      "name": "initialize",
      "description": "Initialize retrieval strategy components",
      "parameters": {},
      "returns": {
        "status": "string",
        "strategies": "array",
        "indexes": "object"
      },
      "admin_only": false,
      "mcp_hints": {
        "read_only": false,
        "idempotent": false,
        "estimated_latency_ms": 100,
        "requires_session": false,
        "category": "admin"
      },
      "security": "none",
      "scope": "system",
      "client_types": []
    },
    {
      "name": "retrieve",
      "description": "Execute document retrieval with specified strategy (hybrid, hierarchical, multi_index, router, bm25).",
      "parameters": {
        "query": {
          "type": "string",
          "required": true
        },
        "strategy": {
          "type": "string",
          "required": false,
          "default": "hybrid",
          "options": [
            "hybrid",
            "hierarchical",
            "multi_index",
            "router",
            "bm25"
          ]
        },
        "top_k": {
          "type": "integer",
          "required": false,
          "default": 10
        },
        "collections": {
          "type": "array",
          "required": false,
          "description": "Qdrant collection names to search (ACL-validated by caller). When provided, bypasses BM25/vector strategy and queries rag_qdrant directly."
        },
        "filters": {
          "type": "object",
          "required": false
        },
        "language": {
          "type": "string",
          "required": false,
          "default": "en"
        }
      },
      "returns": {
        "query": "string",
        "result_count": "integer",
        "strategy_used": "string",
        "fusion_method": "string",
        "retrieval_time_ms": "number",
        "results": "array",
        "collections": "array"
      },
      "admin_only": false,
      "max_observation_chars": 16000,
      "mcp_hints": {
        "read_only": true,
        "idempotent": true,
        "estimated_latency_ms": 2000,
        "requires_session": false,
        "category": "operations"
      },
      "security": "authenticated",
      "scope": "free",
      "client_types": []
    },
    {
      "name": "hybrid_retrieve",
      "description": "Force hybrid (BM25 + Vector) retrieval",
      "parameters": {
        "query": {
          "type": "string",
          "required": true
        },
        "top_k": {
          "type": "integer",
          "required": false,
          "default": 10
        },
        "fusion_method": {
          "type": "string",
          "required": false,
          "default": "rrf"
        },
        "alpha": {
          "type": "number",
          "required": false,
          "default": 0.5
        },
        "filters": {
          "type": "object",
          "required": false
        }
      },
      "returns": {
        "query": "string",
