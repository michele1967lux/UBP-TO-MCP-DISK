      "parameters": {
        "query": {
          "type": "string",
          "required": true
        },
        "top_k": {
          "type": "integer",
          "required": false,
          "default": 10
        },
        "levels": {
          "type": "array",
          "required": false,
          "description": "Levels to search: document, section, paragraph"
        },
        "expand_context": {
          "type": "boolean",
          "required": false,
